# 单副本 8 卡主服务（当前生产配置，2026-10-26 实测通过）
# 安装: cp dsv41-*.service ~/.config/systemd/user/ && systemctl --user daemon-reload
[Unit]
Description=dsv41 inference server (8x GPU pipeline) on 127.0.0.1:8011
[Service]
Type=simple
WorkingDirectory=%h/dsv41_deploy/dsv41_runtime
Environment=DSV41_NVCC=/usr/local/cuda-12.8/bin/nvcc
# 关键：systemd 最小环境必须显式给 UTF-8 locale，否则含多字节的请求体会按 ASCII 解码崩溃
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PYTHONUTF8=1
ExecStart=%h/miniconda3/envs/dsv41/bin/python -m dsv41.serve --ckpt /data/models/DeepSeek-V4.1-Flash --devices 0,1,2,3,4,5,6,7 --host 127.0.0.1 --port 8011 --max-seq-len 262144
Restart=on-failure
RestartSec=30
[Install]
WantedBy=default.target
